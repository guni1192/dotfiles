{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "github>aquaproj/aqua-renovate-config:file#2.13.0(aquaproj-aqua/.*\\.ya?ml)",
    "github>aquaproj/aqua-renovate-config:installer-script#2.13.0(scripts/.*\\.sh)"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "enabledManagers": [
    "devbox",
    "custom.regex"
  ],
  "packageRules": [
    {
      "matchManagers": ["devbox"],
      "matchPackageNames": ["google-cloud-sdk", "awscli2", "flarectl"],
      "enabled": false
    }
  ]
}
