# Personal Git identity (default).
# Copy to config.local and customize. Do NOT commit config.local.

[user]
    name = Your Name
    email = your.email@example.com
    signingkey = ssh-ed25519 AAAA...your-personal-public-key-here

[gpg "ssh"]
    # macOS 1Password:
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    # Linux 1Password:
    # program = /opt/1Password/op-ssh-sign
    # Standard SSH agent:
    # program = /usr/bin/ssh-keygen

# Optional: override email/signingkey under a work checkout path.
# Create config.work (gitignored) and uncomment, adjusting gitdir:
#
# [includeIf "gitdir:~/path/to/work/"]
#     path = ~/.config/git/config.work
